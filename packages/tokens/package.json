{
  "name": "@monorise-team/tokens",
  "version": "0.0.0",
  "description": "Tokeny wygl\u0105du Monorise (system Moonlight glass): CSS dla przegl\u0105darki i komputera, warto\u015bci dla Expo",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Monorise-Team/MonoriseShared.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-css.mjs",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@monorise-team/config": "workspace:*",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
