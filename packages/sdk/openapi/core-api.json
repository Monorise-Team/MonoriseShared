{
  "openapi": "3.1.0",
  "info": {
    "title": "Monorise Core API",
    "version": "0.0.0",
    "summary": "Core API platformy Monorise: tożsamość, firma i stan usługi.",
    "description": "Opis Core API wygenerowany automatycznie z kodu (katalog ścieżek i schematy Zod) i źródło prawdy dla generowanego klienta `@monorise-team/sdk`. Wszystkie odpowiedzi ustawiają nagłówek `Cache-Control: no-store` i używają koperty `{ data, meta, error }` (ADR-0044), z wyjątkiem `GET /core/v1/openapi.json`, który zwraca czysty dokument OpenAPI JSON. Nieznane ścieżki zwracają status `404` z kodem `NOT_FOUND` w kopercie błędu.",
    "license": {
      "name": "Proprietary, all rights reserved",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3200",
      "description": "Lokalnie"
    },
    {
      "url": "https://api.monorise.studio",
      "description": "Produkcja (planowana)"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Stan usługi i opis OpenAPI."
    },
    {
      "name": "People",
      "description": "Pracownicy i konta; tu także dane zalogowanego konta."
    },
    {
      "name": "Organization",
      "description": "Firma zalogowanego użytkownika."
    }
  ],
  "paths": {
    "/core/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Sprawdź stan Core API",
        "description": "Publiczny punkt kontrolny do sprawdzania dostępności usługi. Nie wymaga tokenu dostępu.",
        "responses": {
          "200": {
            "description": "Core API działa poprawnie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/core/v1/me": {
      "get": {
        "tags": [
          "People"
        ],
        "operationId": "getMe",
        "summary": "Pobierz dane zalogowanego konta, pracownika i firmy",
        "description": "Zwraca konto, przypisanego pracownika oraz skrócone dane firmy wynikające z tokenu dostępu.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dane zalogowanego konta, pracownika i firmy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Brak albo nieważny token dostępu albo wyłączone konto (UNAUTHENTICATED, ACCOUNT_DEACTIVATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/core/v1/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getOpenApi",
        "summary": "Pobierz opis OpenAPI 3.1 Core API",
        "description": "Zwraca wygenerowany z kodu dokument OpenAPI 3.1 w formacie JSON. Wyjątek od standardu: odpowiedź to surowy dokument OpenAPI (bez koperty `{ data, meta, error }`), dzięki czemu narzędzia i generatory SDK mogą go wczytać bezpośrednio.",
        "responses": {
          "200": {
            "description": "Dokument OpenAPI 3.1 w formacie JSON (bez koperty).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/core/v1/organization": {
      "get": {
        "tags": [
          "Organization"
        ],
        "operationId": "getOrganization",
        "summary": "Pobierz firmę zalogowanego użytkownika",
        "description": "Zwraca firmę wynikającą z tokenu dostępu wraz z listą jej domen posortowaną według daty dodania.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dane firmy wraz z listą domen.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Brak albo nieważny token dostępu albo wyłączone konto (UNAUTHENTICATED, ACCOUNT_DEACTIVATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token dostępu JWT (EdDSA) z auth.monorise.studio, ważny 5 minut (ADR-0023)."
      }
    },
    "schemas": {
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "ApiErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "null"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ],
        "additionalProperties": false
      },
      "ApiMeta": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "requestId"
        ],
        "additionalProperties": false
      },
      "DomainStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "VERIFIED",
          "FAILED",
          "REVOKED"
        ]
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "workEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "jobTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "FORMER",
              "ANONYMIZED"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "workEmail",
          "jobTitle",
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "UNAUTHENTICATED",
          "PERMISSION_DENIED",
          "NOT_FOUND",
          "VALIDATION_FAILED",
          "RATE_LIMITED",
          "CONFLICT",
          "EMAIL_DOMAIN_NOT_ALLOWED",
          "ORGANIZATION_EXISTS",
          "ORGANIZATION_NOT_ACTIVE",
          "ACCOUNT_DEACTIVATED",
          "INTERNAL"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Health"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "INVITED",
                  "ACTIVE",
                  "DEACTIVATED"
                ]
              }
            },
            "required": [
              "id",
              "email",
              "status"
            ],
            "additionalProperties": false
          },
          "employee": {
            "$ref": "#/components/schemas/Employee"
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "$ref": "#/components/schemas/OrganizationStatus"
              }
            },
            "required": [
              "id",
              "name",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "account",
          "employee",
          "organization"
        ],
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Me"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ],
        "additionalProperties": false
      },
      "OpenApiDocument": {
        "type": "object",
        "properties": {
          "openapi": {
            "type": "string"
          },
          "info": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "version"
            ],
            "additionalProperties": {}
          },
          "paths": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "openapi",
          "info",
          "paths"
        ],
        "additionalProperties": {}
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrganizationStatus"
          },
          "domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationDomain"
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "domains",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "OrganizationDomain": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DomainStatus"
          },
          "isPrimary": {
            "type": "boolean"
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "domain",
          "status",
          "isPrimary",
          "verifiedAt"
        ],
        "additionalProperties": false
      },
      "OrganizationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Organization"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ],
        "additionalProperties": false
      },
      "OrganizationStatus": {
        "type": "string",
        "enum": [
          "PENDING_VERIFICATION",
          "ACTIVE",
          "SUSPENDED",
          "OFFBOARDING",
          "DELETED"
        ]
      }
    }
  }
}
